{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tithimala Calendar Dataset Manifest",
  "type": "object",
  "required": [
    "schema",
    "dataset_version",
    "upstream_repo",
    "upstream_commit",
    "license",
    "calendar_file",
    "notice_file",
    "patro_years",
    "sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "dataset_version": { "type": "string", "minLength": 1 },
    "upstream_repo": { "type": "string", "minLength": 1 },
    "upstream_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "license": { "type": "string", "minLength": 1 },
    "calendar_file": { "type": "string", "minLength": 1 },
    "notice_file": { "type": "string", "minLength": 1 },
    "patro_years": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 1901, "maximum": 2199 }
    },
    "sha256": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    }
  }
}
