{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bikram Sambat Calendar Month Lengths",
  "type": "object",
  "required": ["schema", "source", "min_year", "max_year", "epoch", "month_lengths"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "source": {
      "type": "object",
      "required": ["repo", "commit", "license", "imported"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 7 },
        "license": { "type": "string", "minLength": 1 },
        "imported": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "min_year": { "type": "integer", "minimum": 1900 },
    "max_year": { "type": "integer", "maximum": 2300 },
    "epoch": {
      "type": "object",
      "required": ["bs", "ad"],
      "properties": {
        "bs": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "ad": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "month_lengths": {
      "type": "object",
      "patternProperties": {
        "^\\d{4}$": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": { "type": "integer", "minimum": 28, "maximum": 32 }
        }
      },
      "additionalProperties": false
    }
  }
}
