{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bikram Sambat Patro Year Data",
  "type": "object",
  "required": ["schema", "source", "year", "days"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "source": {
      "type": "object",
      "required": ["repo", "commit", "license", "imported"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 7 },
        "license": { "type": "string", "minLength": 1 },
        "imported": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "year": { "type": "integer", "minimum": 1901, "maximum": 2199 },
    "days": {
      "type": "object",
      "patternProperties": {
        "^\\d{4}-\\d{2}-\\d{2}$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tithi": {
              "type": "object",
              "required": ["np", "en"],
              "properties": {
                "np": { "type": "string", "minLength": 1 },
                "en": { "type": "string", "minLength": 1 }
              }
            },
            "holiday": { "type": "boolean" },
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["np", "en"],
                "properties": {
                  "np": { "type": "string", "minLength": 1 },
                  "en": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
